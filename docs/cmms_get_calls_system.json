{
  "openapi": "3.1.0",
  "info": {
    "title": "digital_twin_simple CMMS integration",
    "version": "1.0.0",
    "description": "A worker jelenlegi kimenő CMMS-hívásai. Ezek nem a digital_twin_simple nyilvános API-végpontjai."
  },
  "servers": [
    {
      "url": "{cmmsBaseUrl}",
      "variables": {
        "cmmsBaseUrl": {
          "default": "http://host.docker.internal:9000",
          "description": "A CMMS_BASE_URL környezeti változó értéke"
        }
      }
    }
  ],
  "security": [
    {
      "CMMSApiKey": []
    }
  ],
  "paths": {
    "/dt-api/asset_failure_causes/{asset_id}": {
      "get": {
        "summary": "Egy eszköz hibaokainak lekérése",
        "operationId": "cmms_get_asset_failure_causes",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "description": "A munkalapból érkező külső cmms_asset_id",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Az eszköz és hibaokai",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "failure_causes"
                  ],
                  "properties": {
                    "asset_id": {
                      "type": "integer"
                    },
                    "failure_causes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "failure_cause_id",
                          "asset_failurecause_id",
                          "operation_ids"
                        ],
                        "properties": {
                          "failure_cause_id": {
                            "type": "integer"
                          },
                          "asset_failurecause_id": {
                            "type": "integer"
                          },
                          "code": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "default_occurrence_probability": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0,
                            "maximum": 99
                          },
                          "severity": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "operation_ids": {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Nincs hibaokadat az eszközhöz"
          }
        }
      }
    },
    "/dt-api/asset_prediction": {
      "post": {
        "summary": "Eszközszintű predikció visszaküldése",
        "operationId": "cmms_post_asset_prediction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prediction_id",
                  "asset_id",
                  "predicted_reliability"
                ],
                "properties": {
                  "prediction_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "asset_id": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Külső cmms_asset_id"
                  },
                  "predicted_reliability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A CMMS elfogadta az eredményt"
          }
        }
      }
    },
    "/dt-api/asset_failure_cause_prediction": {
      "post": {
        "summary": "Hibaokszintű predikciók visszaküldése",
        "operationId": "cmms_post_asset_failure_cause_prediction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prediction_id",
                  "failure_causes"
                ],
                "properties": {
                  "prediction_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "failure_causes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "asset_failurecause_id",
                        "predicted_reliability"
                      ],
                      "properties": {
                        "asset_failurecause_id": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "predicted_reliability": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A CMMS elfogadta az eredményt"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CMMSApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "x-http-timeouts": {
    "total_seconds": 10,
    "connect_seconds": 5,
    "read_seconds": 5
  }
}
